{
  "Charging": {
    "meta": {
      "name": "Charging",
      "description": "Charging control module. Supports opening and closing the charging-port cover, starting and ending charging, and setting the charge limit and charging speed level. Once charging starts, the vehicle battery level changes over time.",
      "version": "1.0.0",
      "from": ""
    },
    "process": {
      "mode_property": "speed_level",
      "start_function": "start_charging",
      "modes": {
        "low": [
          {
            "phase": "charging",
            "minutes": 400
          }
        ],
        "normal": [
          {
            "phase": "charging",
            "minutes": 200
          }
        ],
        "high": [
          {
            "phase": "charging",
            "minutes": 100
          }
        ]
      }
    },
    "properties": {
      "update": {
        "port_cover_open": {
          "type": "boolean",
          "description": "Whether the charging-port cover is open.",
          "mode": 2,
          "value": {
            "default": false
          }
        },
        "charge_limit": {
          "type": "integer",
          "description": "Battery percentage at which further battery increase is capped during charging.",
          "mode": 3,
          "value": {
            "default": 80,
            "unit": "%",
            "minimum": 50,
            "maximum": 100,
            "step": 1,
            "step_origin": 50
          }
        },
        "speed_level": {
          "type": "string",
          "description": "Charging speed level used by the current or next charging cycle.",
          "mode": 3,
          "value": {
            "default": "normal",
            "choices": [
              "low",
              "normal",
              "high"
            ]
          }
        },
        "battery_percent": {
          "type": "integer",
          "description": "Current vehicle battery level. It is changed internally by the charging process.",
          "mode": 2,
          "value": {
            "default": 20,
            "unit": "%",
            "minimum": 0,
            "maximum": 100,
            "step": 1,
            "step_origin": 0
          }
        },
        "status": {
          "type": "string",
          "description": "Charging-process status.",
          "mode": 2,
          "value": {
            "default": "idle",
            "choices": [
              "idle",
              "running",
              "paused",
              "completed"
            ]
          }
        },
        "phase": {
          "type": "string",
          "description": "Current charging-process phase.",
          "mode": 2,
          "value": {
            "default": "idle",
            "choices": [
              "idle",
              "charging",
              "completed"
            ]
          }
        },
        "remaining_minutes": {
          "type": "integer",
          "description": "Whole minutes remaining in the active charging cycle.",
          "mode": 2,
          "value": {
            "default": 0,
            "unit": "minute",
            "minimum": 0,
            "maximum": 400,
            "step": 1,
            "step_origin": 0
          }
        },
        "started_at_minute": {
          "type": "integer",
          "description": "Simulation elapsed-minute value corresponding to the beginning of the current charging cycle.",
          "mode": 2,
          "value": {
            "default": 0,
            "unit": "minute",
            "minimum": 0,
            "step": 1,
            "step_origin": 0
          }
        },
        "progress_minutes": {
          "type": "integer",
          "description": "Whole minutes of progress accumulated in the current charging cycle.",
          "mode": 2,
          "value": {
            "default": 0,
            "unit": "minute",
            "minimum": 0,
            "maximum": 400,
            "step": 1,
            "step_origin": 0
          }
        }
      },
      "disabled": []
    },
    "functions": {
      "update": {
        "get_port_cover_open": {
          "description": "Return whether the charging-port cover is open without changing state.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "port_cover_open"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "port_cover_open",
            "response_key": "port_cover_open"
          },
          "response": {
            "port_cover_open": {
              "type": "boolean",
              "description": "Whether the charging-port cover is open."
            }
          },
          "errorcodes": {}
        },
        "open_port_cover": {
          "description": "Open the charging-port cover. Calling this action when the cover is already open leaves it open.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [],
          "writes": [
            "port_cover_open"
          ],
          "semantics": {
            "kind": "update",
            "fields": {
              "port_cover_open": {
                "value": true
              }
            }
          },
          "response": {},
          "errorcodes": {}
        },
        "close_port_cover": {
          "description": "Close the charging-port cover only when charging is idle or completed. An attempt to close it while charging is rejected and leaves state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "status"
          ],
          "writes": [
            "port_cover_open"
          ],
          "semantics": {
            "kind": "update",
            "fields": {
              "port_cover_open": {
                "value": false
              }
            },
            "preconditions": {
              "status": {
                "one_of": [
                  "idle",
                  "completed"
                ]
              }
            }
          },
          "response": {},
          "errorcodes": {
            "PRECONDITION_FAILED": "The charging-port cover cannot be closed while charging is active."
          }
        },
        "get_charge_limit": {
          "description": "Return the configured charging limit as a battery percentage.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "charge_limit"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "charge_limit",
            "response_key": "charge_limit"
          },
          "response": {
            "charge_limit": {
              "type": "integer",
              "description": "Configured charging limit percentage."
            }
          },
          "errorcodes": {}
        },
        "set_charge_limit": {
          "description": "Set the charge limit to an integer from 50 through 100 percent while charging is idle or completed. Invalid values or attempts made while charging leave state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 50,
                "maximum": 100,
                "multipleOf": 1,
                "description": "Desired charge limit percentage.",
                "examples": [
                  50,
                  80,
                  100
                ]
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "status"
          ],
          "writes": [
            "charge_limit"
          ],
          "semantics": {
            "kind": "set",
            "property": "charge_limit",
            "parameter": "value",
            "preconditions": {
              "status": {
                "one_of": [
                  "idle",
                  "completed"
                ]
              }
            }
          },
          "response": {},
          "errorcodes": {
            "PRECONDITION_FAILED": "The charge limit cannot be changed while charging is active.",
            "INVALID_INPUT_ERROR": "Charge limit must be an integer from 50 through 100."
          }
        },
        "get_speed_level": {
          "description": "Return the selected charging speed level.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "speed_level"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "speed_level",
            "response_key": "speed_level"
          },
          "response": {
            "speed_level": {
              "type": "string",
              "description": "Selected charging speed: low, normal, or high."
            }
          },
          "errorcodes": {}
        },
        "set_speed_level": {
          "description": "Select low, normal, or high charging speed while charging is idle or completed. Invalid values or attempts made while charging leave state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high"
                ],
                "description": "Desired charging speed level.",
                "examples": [
                  "low",
                  "normal",
                  "high"
                ]
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "status"
          ],
          "writes": [
            "speed_level"
          ],
          "semantics": {
            "kind": "set",
            "property": "speed_level",
            "parameter": "value",
            "preconditions": {
              "status": {
                "one_of": [
                  "idle",
                  "completed"
                ]
              }
            }
          },
          "response": {},
          "errorcodes": {
            "PRECONDITION_FAILED": "The charging speed cannot be changed while charging is active.",
            "INVALID_INPUT_ERROR": "Charging speed must be low, normal, or high."
          }
        },
        "get_battery_percent": {
          "description": "Return the current vehicle battery percentage without changing state.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "battery_percent"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "battery_percent",
            "response_key": "battery_percent"
          },
          "response": {
            "battery_percent": {
              "type": "integer",
              "description": "Current battery percentage."
            }
          },
          "errorcodes": {}
        },
        "get_status": {
          "description": "Return the charging-process status without changing state.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "status"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "status",
            "response_key": "status"
          },
          "response": {
            "status": {
              "type": "string",
              "description": "Charging-process status."
            }
          },
          "errorcodes": {}
        },
        "get_phase": {
          "description": "Return the current charging-process phase without changing state.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "phase"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "phase",
            "response_key": "phase"
          },
          "response": {
            "phase": {
              "type": "string",
              "description": "Current charging-process phase."
            }
          },
          "errorcodes": {}
        },
        "get_remaining_minutes": {
          "description": "Return the whole minutes remaining in the active charging cycle.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "remaining_minutes"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "remaining_minutes",
            "response_key": "remaining_minutes"
          },
          "response": {
            "remaining_minutes": {
              "type": "integer",
              "description": "Whole minutes remaining in the charging cycle."
            }
          },
          "errorcodes": {}
        },
        "get_started_at_minute": {
          "description": "Return the simulation elapsed-minute value associated with the start of the current charging cycle.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "started_at_minute"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "started_at_minute",
            "response_key": "started_at_minute"
          },
          "response": {
            "started_at_minute": {
              "type": "integer",
              "description": "Simulation elapsed minute at which the charging cycle began."
            }
          },
          "errorcodes": {}
        },
        "get_progress_minutes": {
          "description": "Return the whole minutes of progress accumulated in the current charging cycle.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "progress_minutes"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "progress_minutes",
            "response_key": "progress_minutes"
          },
          "response": {
            "progress_minutes": {
              "type": "integer",
              "description": "Whole minutes of charging-cycle progress."
            }
          },
          "errorcodes": {}
        },
        "start_charging": {
          "description": "Start a new charging cycle at the supplied speed. The operation succeeds only when status is idle or completed, the charging-port cover is open, and battery_percent is below charge_limit. Starting initializes progress to zero and selects the supplied speed. Invalid or disallowed requests leave all state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "speed_level": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high"
                ],
                "description": "Charging speed for the new cycle.",
                "examples": [
                  "low",
                  "normal",
                  "high"
                ]
              }
            },
            "required": [
              "speed_level"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "port_cover_open",
            "charge_limit",
            "battery_percent",
            "status",
            "progress_minutes"
          ],
          "writes": [
            "speed_level",
            "status",
            "phase",
            "remaining_minutes",
            "started_at_minute",
            "progress_minutes"
          ],
          "semantics": {
            "kind": "process_start",
            "mode_parameter": "speed_level",
            "preconditions": {
              "port_cover_open": true,
              "status": {
                "one_of": [
                  "idle",
                  "completed"
                ]
              }
            }
          },
          "response": {},
          "errorcodes": {
            "PRECONDITION_FAILED": "Charging requires an open port cover, an idle or completed process, and a battery level below the charge limit.",
            "INVALID_INPUT_ERROR": "Charging speed must be low, normal, or high."
          }
        },
        "end_charging": {
          "description": "End an active charging cycle. This preserves battery_percent and all charging settings, clears process timing state, and returns status and phase to idle. The action is rejected unless charging is running.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "status"
          ],
          "writes": [
            "status",
            "phase",
            "remaining_minutes",
            "started_at_minute",
            "progress_minutes"
          ],
          "semantics": {
            "kind": "update",
            "fields": {
              "status": {
                "value": "idle"
              },
              "phase": {
                "value": "idle"
              },
              "remaining_minutes": {
                "value": 0
              },
              "started_at_minute": {
                "value": 0
              },
              "progress_minutes": {
                "value": 0
              }
            },
            "preconditions": {
              "status": "running"
            }
          },
          "response": {},
          "errorcodes": {
            "PRECONDITION_FAILED": "Charging can be ended only while the charging process is running."
          }
        }
      },
      "disabled": []
    },
    "events": {
      "update": {
        "tick": {
          "description": "While status is running, advance charging progress from the cycle start time and reduce remaining_minutes. Increase battery_percent by one point for each four elapsed progress minutes at low speed, each two elapsed progress minutes at normal speed, or each elapsed progress minute at high speed, without exceeding charge_limit. At the exact end of the selected cycle duration, set status and phase to completed and remaining_minutes to zero. Idle, paused, and completed states do not advance.",
          "effect_properties": [
            {
              "name": "status",
              "description": "Determines whether the charging process advances."
            },
            {
              "name": "phase",
              "description": "Tracks the active charging phase and completion."
            },
            {
              "name": "speed_level",
              "description": "Determines cycle duration and battery increase rate."
            },
            {
              "name": "charge_limit",
              "description": "Caps battery growth during the charging cycle."
            },
            {
              "name": "battery_percent",
              "description": "Battery level updated by elapsed charging progress."
            },
            {
              "name": "remaining_minutes",
              "description": "Tracks the remaining duration of the charging cycle."
            },
            {
              "name": "started_at_minute",
              "description": "Provides the time origin used to calculate deterministic progress."
            },
            {
              "name": "progress_minutes",
              "description": "Tracks elapsed charging-cycle progress and battery increments."
            }
          ]
        },
        "after_action": {
          "description": "When a successful action transitions the charging process into running, align started_at_minute with the current simulation time and accumulated progress so subsequent minute ticks advance from the correct time origin. Actions that do not transition the process into running leave the timing origin unchanged.",
          "effect_properties": [
            {
              "name": "status",
              "description": "Identifies whether the charging process has transitioned into running."
            },
            {
              "name": "started_at_minute",
              "description": "Stores the time origin used for deterministic charging progress."
            },
            {
              "name": "progress_minutes",
              "description": "Offsets the time origin by any progress already accumulated."
            }
          ]
        }
      },
      "disabled": []
    }
  }
}
