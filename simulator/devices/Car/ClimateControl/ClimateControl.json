    "events": {
      "update": {
        "tick": {
          "description": "While both electrically powered and enabled, move cabin temperature toward target_temperature by at most 1 degree Celsius per minute. Auto mode may heat or cool, cool mode acts only when cabin temperature is above the target, heat mode acts only when cabin temperature is below the target, and fan mode emits no temperature effect. Emit no temperature effect while power is off, while climate operation is disabled, while the selected directional mode cannot move toward the target, or once the target is reached.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Determines whether the climate-control device can produce a cabin temperature effect."
            },
            {
              "name": "enabled",
              "description": "Determines whether climate temperature control is active while the device is powered."
            },
            {
              "name": "target_temperature",
              "description": "The cabin temperature approached while powered climate temperature control is active."
            },
            {
              "name": "mode",
              "description": "Determines whether the device may heat, cool, do either, or emit no temperature effect."
            }
          ]
        }
