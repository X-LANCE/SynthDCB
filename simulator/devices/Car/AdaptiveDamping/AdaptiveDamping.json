              "type": "string",
              "description": "Selected damping mode: comfort, standard, or sport."
            }
          },
          "errorcodes": {}
        },
        "set_damping_mode": {
          "description": "Select comfort, standard, or sport damping. A valid selection is applied immediately to both the configured mode and effective state. Invalid input is rejected and leaves all state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "comfort",
                  "standard",
                  "sport"
                ],
