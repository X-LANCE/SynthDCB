                "parameter": "mode"
              },
              "effective_state": {
                "parameter": "mode"
              }
            }
          },
          "response": {},
          "errorcodes": {
            "INVALID_INPUT_ERROR": "Damping mode must be comfort, standard, or sport."
          }
        },
        "get_effective_state": {
          "description": "Return the effective damping state currently applied by the module without changing state.",
