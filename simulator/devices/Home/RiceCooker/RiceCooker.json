{
  "RiceCooker": {
    "meta": {
      "name": "RiceCooker",
      "description": "Rice cooker. Users can query and set the cooking program, rice type or texture, and keep-warm state, and can query the cooking stage and inner-pot state. A cooking program heats in stages; after cooking is complete, the device can enter keep-warm mode without continuing to cook.",
      "version": "1.0.0",
      "from": ""
    },
    "process": {
      "mode_property": "cooking_program",
      "start_function": "start_cooking",
      "pause_function": "pause_cooking",
      "resume_function": "resume_cooking",
      "modes": {
        "white_rice": [
          {
            "phase": "heating",
            "minutes": 20
          },
          {
            "phase": "cooking",
            "minutes": 25
          },
          {
            "phase": "resting",
            "minutes": 10
          }
        ],
        "brown_rice": [
          {
            "phase": "heating",
            "minutes": 25
          },
          {
            "phase": "cooking",
            "minutes": 45
          },
          {
            "phase": "resting",
            "minutes": 10
          }
        ],
        "quick_cook": [
          {
            "phase": "heating",
            "minutes": 15
          },
          {
            "phase": "cooking",
            "minutes": 20
          },
          {
            "phase": "resting",
            "minutes": 5
          }
        ],
        "porridge": [
          {
            "phase": "heating",
            "minutes": 20
          },
          {
            "phase": "cooking",
            "minutes": 50
          },
          {
            "phase": "resting",
            "minutes": 10
          }
        ]
      }
    },
    "properties": {
      "update": {
        "power": {
          "type": "boolean",
          "description": "Whether the rice cooker is powered.",
          "mode": 3,
          "value": {
            "default": false
          }
        },
        "cooking_program": {
          "type": "string",
          "description": "Selected cooking program.",
          "mode": 3,
          "value": {
            "default": "white_rice",
            "choices": [
              "white_rice",
              "brown_rice",
              "quick_cook",
              "porridge"
            ]
          }
        },
        "rice_type": {
          "type": "string",
          "description": "Selected rice type.",
          "mode": 3,
          "value": {
            "default": "white_rice",
            "choices": [
              "white_rice",
              "brown_rice",
              "mixed_grain"
            ]
          }
        },
        "texture": {
          "type": "string",
          "description": "Desired cooked texture.",
          "mode": 3,
          "value": {
            "default": "standard",
            "choices": [
              "soft",
              "standard",
              "firm"
            ]
          }
        },
        "keep_warm": {
          "type": "boolean",
          "description": "Whether keep-warm mode is enabled after cooking completes.",
          "mode": 3,
          "value": {
            "default": false
          }
        },
        "inner_pot_state": {
          "type": "string",
          "description": "Simulated state of the inner-pot contents.",
          "mode": 2,
          "value": {
            "default": "empty",
            "choices": [
              "empty",
              "uncooked",
              "cooking",
              "cooked"
            ]
          }
        },
        "status": {
          "type": "string",
          "description": "Current cooking process status.",
          "mode": 2,
          "value": {
            "default": "idle",
            "choices": [
              "idle",
              "running",
              "paused",
              "completed"
            ]
          }
        },
        "phase": {
          "type": "string",
          "description": "Current cooking stage.",
          "mode": 2,
          "value": {
            "default": "idle",
            "choices": [
              "idle",
              "heating",
              "cooking",
              "resting",
              "completed"
            ]
          }
        },
        "remaining_minutes": {
          "type": "integer",
          "description": "Minutes remaining in the selected cooking program.",
          "mode": 2,
          "value": {
            "default": 0,
            "minimum": 0,
            "step": 1,
            "step_origin": 0
          }
        },
        "started_at_minute": {
          "type": "integer",
          "description": "Elapsed world minute at which the current cooking run origin was established.",
          "mode": 2,
          "value": {
            "default": 0,
            "minimum": 0,
            "step": 1,
            "step_origin": 0
          }
        },
        "progress_minutes": {
          "type": "integer",
          "description": "Completed minutes in the current cooking program.",
          "mode": 2,
          "value": {
            "default": 0,
            "minimum": 0,
            "step": 1,
            "step_origin": 0
          }
        }
      },
      "disabled": []
    },
