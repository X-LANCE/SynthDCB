{
  "DualLayerCurtain": {
    "meta": {
      "name": "DualLayerCurtain",
      "description": "A dual-layer curtain variant. It provides separate open or closed states and opening percentages for the sheer and fabric layers, which can be controlled independently; the overall light-blocking effect is determined jointly by both layers.",
      "version": "1.0.0",
      "from": "../Curtain.json"
    },
    "properties": {
      "update": {
        "position": {
          "type": "integer",
          "description": "Derived overall opening percentage, equal to the lower of the sheer and fabric layer opening percentages.",
          "mode": 2,
          "value": {
            "default": 0,
            "unit": "%",
            "minimum": 0,
            "maximum": 100,
            "step": 1,
            "step_origin": 0
          }
        },
        "sheer_open_state": {
          "type": "string",
          "description": "Whether the sheer layer is open or closed. It is closed at 0 percent and open above 0 percent.",
          "mode": 3,
          "value": {
            "default": "closed",
            "choices": [
              "open",
              "closed"
            ]
          }
        },
        "sheer_position": {
          "type": "integer",
          "description": "Opening percentage of the sheer layer, where 0 is fully closed and 100 is fully open.",
          "mode": 3,
          "value": {
            "default": 0,
            "unit": "%",
            "minimum": 0,
            "maximum": 100,
            "step": 1,
            "step_origin": 0
          }
        },
        "fabric_open_state": {
          "type": "string",
          "description": "Whether the fabric layer is open or closed. It is closed at 0 percent and open above 0 percent.",
          "mode": 3,
          "value": {
            "default": "closed",
            "choices": [
              "open",
              "closed"
            ]
          }
        },
        "fabric_position": {
          "type": "integer",
          "description": "Opening percentage of the fabric layer, where 0 is fully closed and 100 is fully open.",
          "mode": 3,
          "value": {
            "default": 0,
            "unit": "%",
            "minimum": 0,
            "maximum": 100,
            "step": 1,
            "step_origin": 0
          }
        }
      },
      "disabled": []
    },
    "functions": {
      "update": {
        "get_open_state": {
          "description": "Return the derived overall curtain state. It is open only when both layer positions are above 0; otherwise it is closed.",
          "response": {
            "open_state": {
              "type": "string",
              "description": "Derived overall state: open when both layer positions are above 0, otherwise closed."
            }
          },
          "errorcodes": {},
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "open_state",
            "position",
            "sheer_position",
            "fabric_position"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "open_state",
            "response_key": "open_state"
          }
        },
        "set_open_state": {
          "description": "Set both layers to fully open or fully closed and recompute the derived overall state and position.",
          "response": {},
          "errorcodes": {},
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "description": "Desired overall curtain state.",
                "enum": [
                  "open",
                  "closed"
                ]
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "open_state",
            "position",
            "sheer_open_state",
            "sheer_position",
            "fabric_open_state",
            "fabric_position"
          ],
          "writes": [
            "open_state",
            "position",
            "sheer_open_state",
            "sheer_position",
            "fabric_open_state",
            "fabric_position"
          ],
          "semantics": {
            "kind": "custom",
            "reason": "For open, set both layer positions to 100; for closed, set both to 0. Derive each layer state from its position, derive overall open_state as open only when both positions are above 0, and derive position as the lower layer position."
          }
        },
        "get_position": {
          "description": "Return the derived overall opening percentage, equal to the lower of the two layer positions.",
          "response": {
            "position": {
              "type": "integer",
              "description": "Derived overall opening percentage from 0 to 100."
            }
          },
          "errorcodes": {},
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "position",
            "sheer_position",
            "fabric_position"
