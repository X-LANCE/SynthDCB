            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "description": "Shared opening percentage for both layers.",
                "minimum": 0,
                "maximum": 100,
                "examples": [
                  0,
                  25,
                  50,
                  100
                ]
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
