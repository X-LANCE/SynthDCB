            "sheer_open_state",
            "sheer_position",
            "fabric_open_state",
            "fabric_position"
          ],
          "writes": [
            "position",
            "open_state",
            "sheer_open_state",
            "sheer_position",
            "fabric_open_state",
            "fabric_position"
          ],
          "semantics": {
            "kind": "custom",
            "reason": "Decrease both layer positions by percentage_points, floor each at 0, and recompute each layer state, overall open_state, and overall position."
          }
        },
