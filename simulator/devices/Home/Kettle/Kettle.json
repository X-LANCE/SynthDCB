    "events": {
      "update": {
        "tick": {
          "description": "If powered and heating is true, raise current_temperature by exactly 5.0 degrees Celsius per simulation minute, rounded to one decimal place, and clamp it to target_temperature. When the target is reached, set heating to false. If keep_warm is true after the target is reached, actively maintain current_temperature at target_temperature. If power is false, do not change temperature or any heating process. Set boiling to true exactly when current_temperature is 100.0 and false otherwise.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the kettle is powered."
            },
            {
              "name": "target_temperature",
              "description": "Configured target temperature."
            },
            {
              "name": "heating",
              "description": "Whether active heating is enabled."
            },
            {
              "name": "keep_warm",
              "description": "Whether keep-warm maintenance is active."
            },
            {
              "name": "current_temperature",
              "description": "Current water temperature."
            },
            {
              "name": "boiling",
              "description": "Whether the water is boiling."
            }
          ]
        },
        "after_action": {
          "description": "After a successful power transition to false, set heating and keep_warm to false so no heating or maintenance remains active. Other successful state changes do not directly alter the water temperature.",
          "effect_properties": [
            {
              "name": "power",
