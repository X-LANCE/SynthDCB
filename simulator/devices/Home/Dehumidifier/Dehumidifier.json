    "events": {
      "update": {
        "tick": {
          "description": "The tick interval is one elapsed world minute. If power is false, tank_full is true, or space humidity is at or below target_humidity, emit no humidity effect and do not increase tank_fill_units. Otherwise emit a humidity delta that lowers space humidity by the lesser of the current humidity minus target_humidity and the deterministic removal rate. The removal rate is 1 %RH per minute for low intensity, 2 %RH per minute for medium intensity, and 3 %RH per minute for high intensity, multiplied by 1 for low fan speed, 1.5 for medium fan speed, and 2 for high fan speed; the resulting rate is rounded down to the nearest integer and has a minimum of 1 %RH per minute. When continuous_drainage is false, increase tank_fill_units by the actual integer humidity removal for that minute, capped at 60, and set tank_full to true when it reaches 60. When continuous_drainage is true, tank_fill_units and tank_full remain unchanged. Emit only the humidity delta effect for the active minute.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the dehumidifier is powered."
            },
            {
              "name": "target_humidity",
              "description": "Desired room humidity target."
            },
            {
              "name": "dehumidification_intensity",
              "description": "Configured moisture-removal intensity."
            },
            {
              "name": "fan_speed",
              "description": "Configured fan speed."
            },
            {
              "name": "tank_full",
              "description": "Whether the collection tank is full."
            },
            {
              "name": "continuous_drainage",
              "description": "Whether collected water is continuously drained."
            },
            {
              "name": "tank_fill_units",
              "description": "Accumulated non-drained dehumidifying minutes."
            }
          ]
        }
      },
