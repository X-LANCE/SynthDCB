            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power"
          ],
          "writes": [
            "power"
          ],
          "semantics": {
            "kind": "set",
            "property": "power",
            "parameter": "value"
          },
          "response": {},
          "errorcodes": {}
        }
      },
      "disabled": []
    },
    "events": {
      "update": {},
      "disabled": []
    }
  }
