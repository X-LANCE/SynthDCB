    "events": {
      "update": {
        "tick": {
          "description": "While powered, adjust the room temperature toward the target in cool, heat, and automatic operation, or reduce room humidity in dry operation. Automatic operation cools when the room is above the target and heats when it is below the target. Fan operation does not directly change temperature or humidity. Auxiliary heating turns off when the room reaches the target temperature. When unpowered, emit zero contributions.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the air conditioner is powered."
            },
            {
              "name": "operating_mode",
              "description": "Current operating mode."
            },
            {
              "name": "target_temperature",
              "description": "Desired room temperature."
            },
            {
              "name": "fan_speed",
              "description": "Current fan speed."
            },
            {
              "name": "auxiliary_heating",
              "description": "Whether auxiliary heating is enabled."
            }
          ]
        },
        "after_action": {
          "description": "After a successful action, if operating_mode is cool, fan or dry, internally set auxiliary_heating to false. Otherwise preserve auxiliary_heating. This hook emits no Space effects.",
          "effect_properties": [
            {
              "name": "operating_mode",
              "description": "Required for mode-dependent auxiliary-heating interlock."
            },
            {
              "name": "auxiliary_heating",
              "description": "Required for mode-dependent auxiliary-heating interlock."
            }
          ]
        }
