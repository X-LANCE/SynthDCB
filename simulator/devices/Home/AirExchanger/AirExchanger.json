  "AirExchanger": {
    "meta": {
      "name": "AirExchanger",
      "description": "Fresh-air exchanger. Users can query and set the ventilation mode and fan speed, and can query indoor and outdoor air quality and filter state. While running, the device draws in and filters outdoor air to gradually improve the air quality of its space; heat-exchange mode maintains ventilation while reducing temperature changes.",
      "version": "1.0.0",
      "from": ""
    },
    "properties": {
      "update": {
        "power": {
          "type": "boolean",
          "description": "Whether the air exchanger is powered.",
          "mode": 3,
          "value": {
            "default": false
          }
        },
        "ventilation_mode": {
          "type": "string",
          "description": "Ventilation mode: normal exchanges air directly; heat_exchange maintains ventilation while reducing the temperature effect of incoming outdoor air.",
          "mode": 3,
          "value": {
            "default": "normal",
            "choices": [
              "normal",
              "heat_exchange"
            ]
          }
        },
        "fan_speed": {
          "type": "integer",
          "description": "Fan speed level used while the air exchanger is running.",
          "mode": 3,
          "value": {
            "default": 1,
            "minimum": 1,
            "maximum": 3,
            "step": 1,
            "step_origin": 1
          }
        },
        "indoor_air_quality": {
          "type": "integer",
          "description": "Device-reported indoor air quality index, synchronized on each tick with the containing Space air_quality value.",
          "mode": 2,
          "value": {
            "default": 100,
            "minimum": 0,
            "maximum": 500,
            "step": 1,
            "step_origin": 0
          }
        },
        "outdoor_air_quality": {
          "type": "integer",
          "description": "Outdoor air quality index used as the filtered incoming-air source.",
          "mode": 2,
          "value": {
            "default": 50,
            "minimum": 0,
            "maximum": 500,
            "step": 1,
            "step_origin": 0
          }
        },
        "outdoor_temperature": {
          "type": "float",
          "description": "Outdoor air temperature used to calculate the ventilation temperature contribution.",
          "mode": 2,
          "value": {
            "default": 10.0,
            "minimum": -50,
            "maximum": 80,
            "precision": 1
          }
        },
        "filter_state": {
          "type": "string",
          "description": "Current filter maintenance state. Normal provides full filtration, needs_cleaning provides half filtration, and replace provides no filtration improvement.",
          "mode": 2,
          "value": {
            "default": "normal",
            "choices": [
              "normal",
              "needs_cleaning",
              "replace"
            ]
          }
        }
      },
