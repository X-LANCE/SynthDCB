    "events": {
      "update": {
        "tick": {
          "description": "The containing Space property air_quality is the indoor air-quality state. While power is true, each elapsed minute moves that Space air_quality toward outdoor_air_quality by a deterministic amount: fan_speed 1 uses 2 AQI points per minute, fan_speed 2 uses 4 points, and fan_speed 3 uses 6 points. The movement is toward outdoor_air_quality, so ventilation may worsen indoor air quality when outdoor air is worse. filter_state normal applies the full rate, needs_cleaning applies half the rate rounded up, and replace applies zero rate. The value is clamped to the inclusive 0 through 500 range and rounded to the nearest integer. On every tick, indoor_air_quality is internally set to the current containing Space air_quality value. While powered, ventilation emits a temperature delta each minute: normal mode uses 0.10 multiplied by (outdoor_temperature minus containing Space temperature), and heat_exchange uses 0.02 multiplied by that same temperature difference. Thus heat_exchange reduces the normal-mode thermal change by 80 percent. The temperature increment is rounded to one decimal place and is not emitted while unpowered. Represent temperature movement using an approach effect toward outdoor_temperature, with rate_per_minute equal to the absolute rounded increment. Represent air-quality movement using an approach effect toward outdoor_air_quality at the filtered AQI rate. These native approach operations preserve the stated per-minute movement while composing with other Home approach effects. Unpowered ventilation emits no air-quality or temperature effect.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the air exchanger is powered."
            },
            {
              "name": "ventilation_mode",
              "description": "Selected ventilation mode."
            },
            {
              "name": "fan_speed",
              "description": "Current fan speed level."
            },
            {
              "name": "indoor_air_quality",
              "description": "Device-reported indoor air quality synchronized from the Space."
            },
            {
              "name": "outdoor_air_quality",
              "description": "Outdoor air quality target."
            },
            {
              "name": "outdoor_temperature",
              "description": "Outdoor temperature used for the temperature contribution."
            },
            {
              "name": "filter_state",
              "description": "Filter maintenance state affecting filtration rate."
            }
          ]
        }
      },
      "disabled": []
    }
