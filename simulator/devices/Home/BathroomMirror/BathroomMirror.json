            "POWER_OFF": "The mirror must be powered on to read defogging."
          }
        },
        "set_defogging": {
          "description": "Enable or disable the mirror's defogging function. The mirror must be powered on. Invalid input leaves state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "boolean",
                "description": "Whether defogging should be enabled."
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power",
            "defogging"
          ],
          "writes": [
            "defogging"
          ],
          "semantics": {
            "kind": "set",
            "property": "defogging",
            "parameter": "value",
