        "set_power": {
          "description": "Set power and dependent property access. While off, every non-power property is inaccessible through public getters/setters. Turning on restores access. A property marked auto_reset resets only when turning on.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power"
          ],
          "writes": [
            "power"
          ],
          "semantics": {
            "kind": "set",
            "property": "power",
            "parameter": "value"
          },
          "response": {},
          "errorcodes": {}
        }
      },
      "disabled": []
    },
    "events": {
      "update": {
        "after_action": {
          "description": "Recalculate the mirror's absolute illuminance contribution after a successful state-changing action. The contribution is zero when power is off; when power is on, it is equal to the configured brightness percentage multiplied by 10 lux.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Determines whether the mirror contributes light."
            },
            {
              "name": "brightness",
              "description": "Determines the mirror's illuminance contribution while powered on."
            }
          ]
        }
      },
      "disabled": []
    }
  }
