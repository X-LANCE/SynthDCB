{
  "BathroomMirror": {
    "meta": {
      "name": "BathroomMirror",
      "description": "Bathroom mirror. Users can query and set lighting brightness, the defogging state, and the automatic-lighting function. Its lighting changes room brightness.",
      "version": "1.0.0",
      "from": ""
    },
    "properties": {
      "update": {
        "power": {
          "type": "boolean",
          "description": "Whether the bathroom mirror is powered. When false, non-power properties remain configured but are not publicly accessible or changeable.",
          "mode": 3,
          "value": {
            "default": false
          }
        },
        "brightness": {
          "type": "integer",
          "description": "Configured mirror-light brightness percentage. This value persists while the mirror is powered off and is publicly accessible only while power is on.",
          "mode": 3,
          "value": {
            "default": 50,
            "unit": "%",
            "minimum": 0,
            "maximum": 100,
            "step": 1,
            "step_origin": 0
          }
        },
        "defogging": {
          "type": "boolean",
          "description": "Whether the mirror's defogging function is enabled. This setting persists while the mirror is powered off and is publicly accessible only while power is on.",
          "mode": 3,
          "value": {
            "default": false
          }
        },
        "automatic_lighting": {
          "type": "boolean",
          "description": "Whether automatic lighting is enabled. This setting persists while the mirror is powered off and is publicly accessible only while power is on.",
          "mode": 3,
          "value": {
            "default": false
          }
        }
      },
      "disabled": []
    },
    "functions": {
      "update": {
        "get_brightness": {
          "description": "Return the configured lighting brightness percentage. The mirror must be powered on; otherwise the function fails without changing state.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "power",
            "brightness"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "brightness",
            "response_key": "brightness",
            "preconditions": {
              "power": true
            }
          },
          "response": {
            "brightness": {
              "type": "integer",
              "description": "Configured brightness from 0 through 100 percent."
            }
          },
          "errorcodes": {
            "POWER_OFF": "The mirror must be powered on to read brightness."
          }
        },
        "set_brightness": {
          "description": "Set the mirror-light brightness to an integer percentage from 0 through 100. The mirror must be powered on. Invalid input leaves state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "description": "Desired lighting brightness percentage.",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power",
            "brightness"
          ],
          "writes": [
            "brightness"
          ],
          "semantics": {
            "kind": "set",
            "property": "brightness",
            "parameter": "value",
            "preconditions": {
              "power": true
            }
          },
          "response": {},
          "errorcodes": {
            "POWER_OFF": "The mirror must be powered on to change brightness.",
            "INVALID_INPUT_ERROR": "value must be an integer from 0 through 100."
          }
        },
        "get_defogging": {
          "description": "Return whether defogging is enabled. The mirror must be powered on; otherwise the function fails without changing state.",
          "parameters_schema": {
            "type": "object",
