            "INVALID_INPUT_ERROR": "value must be a boolean."
          }
        },
        "get_power": {
          "description": "Get the current power state.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "power"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
