            "feeding_mode",
            "remaining_food",
            "jammed"
          ],
          "writes": [
            "remaining_food"
          ],
          "semantics": {
            "kind": "custom",
            "reason": "Immediate feeding conditionally validates power, jam state, and available hopper quantity before deducting the configured portion."
          },
          "response": {
            "success": {
              "type": "boolean",
              "description": "Whether the full configured portion was dispensed."
            }
          },
          "errorcodes": {
            "powered_off": "The feeder is not powered.",
            "insufficient_food": "The hopper contains fewer portions than configured.",
            "jammed": "The dispensing mechanism is jammed."
          }
        },
        "get_power": {
