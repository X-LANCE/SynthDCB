          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "remaining_food",
            "response_key": "remaining_food",
            "preconditions": {
              "power": true
            }
          },
          "response": {
            "remaining_food": {
              "type": "integer",
              "description": "Food remaining in the hopper, in portions."
            }
          },
          "errorcodes": {}
        },
        "feed_now": {
          "description": "Immediately dispense the configured feeding portion while powered. The action deducts the full portion only when the hopper contains at least that many portions and the dispensing mechanism is not jammed. Otherwise it fails atomically and leaves the hopper unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power",
