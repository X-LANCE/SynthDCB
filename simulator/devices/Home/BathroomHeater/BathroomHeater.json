    "events": {
      "update": {
        "after_action": {
          "description": "After a successful mutation, update this device's absolute contributions to the containing Home space. If power and lighting are both true, set the device's illuminance contribution to 300 lux; otherwise set its illuminance contribution to 0 lux. If power and heating are both true, set the device's temperature contribution to 0.5 degrees Celsius multiplied by heating_intensity; otherwise set its temperature contribution to 0 degrees Celsius. The lighting and temperature contributions are independent and are recalculated whenever this event is dispatched.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the bathroom heater has electrical power."
            },
            {
              "name": "lighting",
              "description": "Whether bathroom lighting is enabled."
            },
            {
              "name": "heating",
              "description": "Whether bathroom heating is enabled."
            },
