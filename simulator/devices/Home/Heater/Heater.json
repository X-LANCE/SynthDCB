    "events": {
      "update": {
        "tick": {
          "description": "While powered and in heat mode, compare the room temperature from space_state with target_temperature. If the room is below the target, emit an approach effect toward target_temperature, with the heating rate determined by heating_intensity. If the room is at or above the target, or if the heater is unpowered or in off mode, emit a zero temperature contribution so that no heating remains active.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the heater is electrically powered."
            },
            {
              "name": "target_temperature",
              "description": "Desired room temperature."
            },
