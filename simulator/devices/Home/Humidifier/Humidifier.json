    "events": {
      "update": {
        "tick": {
          "description": "On each tick, while powered, increase the containing space's humidity by a deterministic contribution when its current humidity is below target_humidity. The contribution is 1 percentage point at low intensity, 2 at medium intensity, and 3 at high intensity; sleep mode halves the contribution using integer reduction, with a minimum contribution of 1 while humidification is needed. Emit no humidity contribution when unpowered or when current humidity is at least target_humidity.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the humidifier is powered."
            },
            {
              "name": "sleep_mode",
              "description": "Whether sleep mode is enabled."
            },
