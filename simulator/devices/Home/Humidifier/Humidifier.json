          "description": "Desired humidity for the containing space.",
          "mode": 3,
          "value": {
            "default": 50,
            "unit": "%RH",
            "minimum": 0,
            "maximum": 100,
            "step": 1,
            "step_origin": 0
          }
        },
        "humidification_intensity": {
          "type": "string",
          "description": "Humidification output intensity.",
          "mode": 3,
          "value": {
