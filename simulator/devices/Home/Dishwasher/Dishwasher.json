            "preconditions": {
              "power": true
            }
          }
        },
        "set_cleaning_intensity": {
          "description": "Set cleaning intensity while powered and idle or completed.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "light",
                  "standard",
                  "strong"
                ]
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power",
            "status",
            "cleaning_intensity"
          ],
          "writes": [
            "cleaning_intensity"
          ],
          "semantics": {
            "kind": "set",
            "property": "cleaning_intensity",
            "parameter": "value",
            "preconditions": {
              "power": true,
              "status": {
                "one_of": [
                  "idle",
                  "completed"
                ]
              }
            }
          }
        },
        "get_drying_state": {
          "description": "Get whether the drying stage is enabled while powered.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "power",
            "drying_state"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "drying_state",
            "response_key": "drying_state",
            "preconditions": {
              "power": true
            }
          }
        },
        "set_drying_state": {
          "description": "Enable or disable the drying stage while powered and idle or completed. When disabled, future cycles skip drying.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power",
            "status",
            "drying_state"
          ],
          "writes": [
            "drying_state"
          ],
          "semantics": {
            "kind": "set",
            "property": "drying_state",
            "parameter": "value",
            "preconditions": {
              "power": true,
              "status": {
                "one_of": [
                  "idle",
                  "completed"
                ]
              }
            }
          }
        },
        "get_detergent_dispensing": {
          "description": "Get whether automatic detergent dispensing is enabled while powered.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "power",
            "detergent_dispensing"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "detergent_dispensing",
            "response_key": "detergent_dispensing",
            "preconditions": {
              "power": true
            }
          }
        },
        "set_detergent_dispensing": {
          "description": "Enable or disable automatic detergent dispensing while powered and idle or completed.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power",
            "status",
            "detergent_dispensing"
          ],
          "writes": [
            "detergent_dispensing"
          ],
          "semantics": {
            "kind": "set",
            "property": "detergent_dispensing",
            "parameter": "value",
            "preconditions": {
              "power": true,
              "status": {
                "one_of": [
                  "idle",
                  "completed"
                ]
              }
            }
          }
        },
        "get_status": {
          "description": "Get the current dishwasher process status while powered.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
