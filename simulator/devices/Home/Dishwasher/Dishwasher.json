            "started_at_minute",
            "progress_minutes"
          ],
          "writes": [
            "status",
            "phase",
            "remaining_minutes",
            "started_at_minute",
            "progress_minutes",
            "washing_program"
          ],
          "semantics": {
            "kind": "process_start",
            "mode_parameter": "mode",
