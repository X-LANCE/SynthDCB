    },
    "events": {
      "update": {
        "tick": {
          "description": "Advance a running powered dishwasher using elapsed world minutes and the selected program. If drying_state is false, omit the dry phase and calculate total and remaining time from wash and rinse only. Preserve configuration, clamp progress and remaining time, advance stages at exact boundaries, and set status and phase to completed at the end. Paused, idle, completed, or unpowered cycles do not advance.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the dishwasher is powered."
            },
            {
              "name": "washing_program",
              "description": "Selected dishwasher program."
            },
            {
              "name": "drying_state",
              "description": "Whether the dry phase is included."
            },
            {
              "name": "status",
              "description": "Current process status."
            },
            {
              "name": "phase",
              "description": "Current process stage."
            },
            {
              "name": "remaining_minutes",
              "description": "Minutes remaining."
            },
            {
              "name": "started_at_minute",
              "description": "Process origin minute."
            },
            {
              "name": "progress_minutes",
              "description": "Completed process minutes."
            }
          ]
        },
        "after_action": {
          "description": "On transition into running, establish started_at_minute as elapsed world minutes minus persisted progress_minutes. When power changes from on to off during a running cycle, pause the cycle while retaining progress, phase, and remaining time. Powering on restores access but does not resume the cycle.",
          "effect_properties": [
            {
              "name": "power",
              "description": "Whether the dishwasher is powered."
            },
            {
              "name": "status",
              "description": "Current process status."
            },
            {
              "name": "started_at_minute",
              "description": "Process origin minute."
            },
            {
              "name": "progress_minutes",
              "description": "Completed process minutes."
            },
            {
              "name": "phase",
              "description": "Current process stage."
            },
            {
              "name": "remaining_minutes",
              "description": "Minutes remaining."
            }
          ]
        }
      },
      "disabled": []
    }
