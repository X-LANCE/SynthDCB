{
  "Dishwasher": {
    "meta": {
      "name": "Dishwasher",
      "description": "Dishwasher. Users can query and set the washing program, cleaning intensity, drying state, and detergent dispensing. The current stage and remaining time are queryable; preset stages associated with the washing program progress over time, and operation is started through a manual setting.",
      "version": "1.0.0",
      "from": ""
    },
    "process": {
      "mode_property": "washing_program",
      "start_function": "start_cycle",
      "pause_function": "pause_cycle",
      "resume_function": "resume_cycle",
      "modes": {
        "eco": [
          {
            "phase": "wash",
            "minutes": 45
          },
          {
            "phase": "rinse",
            "minutes": 20
          },
          {
            "phase": "dry",
            "minutes": 30
          }
        ],
        "normal": [
          {
            "phase": "wash",
            "minutes": 60
          },
          {
            "phase": "rinse",
            "minutes": 25
          },
          {
            "phase": "dry",
            "minutes": 40
          }
        ],
        "intensive": [
          {
            "phase": "wash",
            "minutes": 90
          },
          {
            "phase": "rinse",
            "minutes": 30
          },
          {
            "phase": "dry",
            "minutes": 50
          }
        ]
      }
    },
    "properties": {
      "update": {
        "power": {
          "type": "boolean",
          "description": "Whether the dishwasher is powered.",
          "mode": 3,
          "value": {
            "default": false
          }
        },
        "washing_program": {
          "type": "string",
          "description": "Selected washing program.",
          "mode": 3,
          "value": {
            "default": "normal",
            "choices": [
              "eco",
              "normal",
              "intensive"
            ]
          }
        },
        "cleaning_intensity": {
          "type": "string",
          "description": "Configured cleaning intensity.",
          "mode": 3,
          "value": {
            "default": "standard",
            "choices": [
              "light",
              "standard",
              "strong"
            ]
          }
        },
        "drying_state": {
          "type": "boolean",
          "description": "Whether the drying stage is enabled. When false, the declared dry stage is skipped and its duration is removed from the process.",
          "mode": 3,
          "value": {
            "default": true
          }
        },
        "detergent_dispensing": {
          "type": "boolean",
          "description": "Whether automatic detergent dispensing is enabled.",
          "mode": 3,
          "value": {
            "default": true
          }
        },
        "status": {
          "type": "string",
          "description": "Current dishwasher process status.",
          "mode": 2,
          "value": {
            "default": "idle",
            "choices": [
              "idle",
              "running",
              "paused",
              "completed"
            ]
          }
        },
        "phase": {
          "type": "string",
          "description": "Current washing stage.",
          "mode": 2,
          "value": {
            "default": "idle",
            "choices": [
              "idle",
              "wash",
              "rinse",
              "dry",
              "completed"
            ]
          }
        },
        "remaining_minutes": {
          "type": "integer",
          "description": "Minutes remaining in the selected dishwasher program, excluding a disabled drying stage.",
          "mode": 2,
          "value": {
            "default": 0,
            "minimum": 0,
            "step": 1,
            "step_origin": 0
          }
        },
        "started_at_minute": {
          "type": "integer",
          "description": "Elapsed world minute at which the current process origin was established.",
          "mode": 2,
          "value": {
            "default": 0,
            "minimum": 0,
            "step": 1,
            "step_origin": 0
          }
        },
        "progress_minutes": {
          "type": "integer",
          "description": "Completed minutes from the beginning of the selected process.",
          "mode": 2,
          "value": {
            "default": 0,
            "minimum": 0,
            "step": 1,
            "step_origin": 0
          }
        }
      },
      "disabled": []
    },
    "functions": {
      "update": {
        "get_washing_program": {
          "description": "Get the selected washing program while powered.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "power",
            "washing_program"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "washing_program",
            "response_key": "washing_program",
            "preconditions": {
              "power": true
            }
          }
        },
        "set_washing_program": {
          "description": "Select a washing program while powered and idle or completed.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "eco",
                  "normal",
                  "intensive"
                ]
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power",
            "status",
            "washing_program"
          ],
          "writes": [
            "washing_program"
          ],
          "semantics": {
            "kind": "set",
            "property": "washing_program",
            "parameter": "value",
            "preconditions": {
              "power": true,
              "status": {
                "one_of": [
                  "idle",
                  "completed"
                ]
              }
            }
          }
        },
        "get_cleaning_intensity": {
          "description": "Get cleaning intensity while powered.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "power",
