              "power": true
            }
          }
        },
        "start_cycle": {
          "description": "Start the program specified by mode while powered and idle or completed. Set washing_program to mode before starting; if drying is disabled, omit the dry stage.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "eco",
                  "normal",
                  "intensive"
                ]
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "power",
            "status",
            "washing_program",
            "drying_state",
            "phase",
