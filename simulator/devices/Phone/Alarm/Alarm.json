                "parameter": "hour"
              },
              "minute": {
                "parameter": "minute"
              },
              "label": {
                "parameter": "label"
              },
              "weekdays": {
                "parameter": "weekdays"
              },
              "enabled": {
                "parameter": "enabled"
              }
            },
