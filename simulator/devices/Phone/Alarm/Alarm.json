{
  "Alarm": {
    "meta": {
      "name": "Alarm",
      "description": "Alarm configuration application, placed in Application. Supports adding, querying, partially updating, deleting, enabling, and disabling multiple alarms. Stores hour, minute, label, enabled state, and a list of weekdays without duplicates. An empty weekday list represents a one-time configuration. Updates preserve unspecified fields and unrelated records.",
      "version": "1.0.0",
      "from": ""
    },
    "properties": {
      "update": {
        "alarms": {
          "type": "dict",
          "description": "Alarm records keyed by stable string IDs. Each record contains an hour from 0 through 23, a minute from 0 through 59, a label, an enabled state, and unique weekdays from 1 through 7. An empty weekday list represents a one-time configuration.",
          "mode": 3,
          "value": {
            "default": {
              "alarm_1": {
                "hour": 8,
                "minute": 0,
                "label": "Workday",
                "enabled": false,
                "weekdays": [
                  1,
                  2,
                  3,
                  4,
                  5
                ]
              },
              "alarm_2": {
                "hour": 9,
                "minute": 0,
                "label": "Weekend",
                "enabled": false,
                "weekdays": [
                  6,
                  7
                ]
              }
            }
          }
        }
      },
      "disabled": []
    },
    "functions": {
      "update": {
        "add_alarm": {
          "description": "Add an alarm with the supplied hour, minute, label, weekdays, and optional enabled state. The system generates and returns a new stable string ID without changing existing records. Hour must be 0 through 23, minute must be 0 through 59, the label must contain 1 through 80 characters, and weekdays must contain no duplicate values outside 1 through 7. An empty weekdays list represents a one-time configuration. Invalid arguments leave the collection unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "hour": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23,
                "examples": [
                  7,
                  12,
                  21
                ]
              },
              "minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 59,
                "examples": [
                  0,
                  15,
                  45
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "examples": [
                  "Morning",
                  "School pickup",
                  "Medication"
                ]
              },
              "weekdays": {
                "type": "array",
                "minItems": 0,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "examples": [
                  [],
                  [
                    1,
                    2,
                    3,
                    4,
                    5
                  ],
                  [
                    6,
                    7
                  ]
                ]
              },
              "enabled": {
                "type": "boolean",
                "default": false,
                "examples": [
                  true,
                  false
                ]
              }
            },
            "required": [
              "hour",
              "minute",
              "label",
              "weekdays"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "alarms"
          ],
          "writes": [
