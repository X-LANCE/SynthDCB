    "events": {
      "update": {
        "tick": {
          "description": "Each simulated minute, reevaluates rule windows using wall-clock time in each rule's configured time zone. A valid enabled manual override remains authoritative. Otherwise, enabled scheduled rules whose windows currently match compete by immutable priority, with larger values winning and the lexicographically smallest stable rule ID breaking equal-priority ties. The selected rule's interruption exceptions become effective; if no rule matches, the effective rule ID and policy are cleared and the source becomes none.",
          "effect_properties": [
            {
              "name": "rules",
              "description": "Stored rules containing eligibility, priorities, policies, time zones, repeat days, and time windows."
            },
            {
              "name": "manual_override_rule_id",
              "description": "Manual selection that takes precedence over scheduled rules."
            },
            {
              "name": "effective_rule_id",
              "description": "Currently resolved rule ID updated by reevaluation."
            },
            {
              "name": "effective_source",
              "description": "Currently resolved policy source updated by reevaluation."
            },
            {
              "name": "effective_policy",
              "description": "Currently resolved interruption policy updated by reevaluation."
            }
          ]
        },
        "after_action": {
          "description": "After a successful state-changing action, immediately reevaluates the effective policy. A deleted, missing, or disabled manual rule clears the manual override. A valid manual rule wins; otherwise the current time windows, immutable priorities, and stable-ID tie-break determine the scheduled winner. This makes rule edits, deletion, manual activation, and override exit observable without waiting for the next minute.",
          "effect_properties": [
            {
              "name": "rules",
              "description": "Stored rules used to validate manual selection and resolve current schedules."
            },
            {
              "name": "manual_override_rule_id",
              "description": "Manual selection to validate, retain, or clear."
            },
            {
              "name": "effective_rule_id",
              "description": "Currently resolved rule ID updated after actions."
            },
            {
              "name": "effective_source",
              "description": "Currently resolved policy source updated after actions."
            },
            {
              "name": "effective_policy",
              "description": "Currently resolved interruption policy updated after actions."
            }
          ]
        }
      },
      "disabled": []
    }
  }
