{
  "WiFi": {
    "meta": {
      "name": "WiFi",
      "description": "Wireless network settings, placed in Setting. Supports enabling/disabling Wi-Fi, querying saved networks, connecting, disconnecting, and forgetting networks. Connection requires Wi-Fi to be enabled and the network to be saved. Disabling Wi-Fi or forgetting the current network immediately disconnects it. Other network records are preserved, and re-enabling Wi-Fi does not automatically reconnect.",
      "version": "1.0.0",
      "from": ""
    },
    "properties": {
      "update": {
        "enabled": {
          "type": "boolean",
          "description": "Whether Wi-Fi is enabled. Enabling Wi-Fi does not automatically establish a connection.",
          "mode": 3,
          "value": {
            "default": false
          }
        },
        "saved_networks": {
          "type": "dict",
          "description": "Saved wireless networks keyed by stable network ID. Each record contains the network's display name and no credentials.",
          "mode": 2,
          "value": {
            "default": {
              "Home": {
                "name": "Home"
              },
              "Office": {
                "name": "Office"
              }
            }
          }
        },
        "connected_network_id": {
          "type": "string",
          "description": "The ID of the currently connected saved network, or an empty string when disconnected.",
          "mode": 2,
          "value": {
            "default": "",
            "pattern": "^[A-Za-z0-9_-]*$",
            "max_length": 128
          }
        }
      },
      "disabled": []
    },
    "functions": {
      "update": {
        "get_enabled": {
          "description": "Return whether Wi-Fi is currently enabled without changing any state.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "enabled"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "enabled",
            "response_key": "enabled",
            "preconditions": {}
          },
          "response": {
            "enabled": {
              "type": "boolean",
              "description": "Whether Wi-Fi is enabled."
            }
          }
        },
        "set_enabled": {
          "description": "Enable or disable Wi-Fi. Disabling immediately sets connected_network_id to an empty string while preserving every saved network. Enabling preserves saved networks and does not automatically reconnect. Invalid arguments leave all state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "The desired Wi-Fi enabled state.",
                "examples": [
                  true,
                  false
                ]
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [],
          "writes": [
            "enabled",
            "connected_network_id"
          ],
          "semantics": {
            "kind": "set",
            "property": "enabled",
            "parameter": "enabled",
            "preconditions": {}
          }
        },
        "get_saved_networks": {
          "description": "Return all saved network records keyed by their stable network IDs without changing any state.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "saved_networks"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "saved_networks",
            "response_key": "saved_networks",
            "preconditions": {}
          },
          "response": {
            "saved_networks": {
              "type": "object",
              "description": "The complete dictionary of saved network records keyed by network ID."
            }
          }
        },
        "get_connected_network_id": {
          "description": "Return the ID of the currently connected saved network, or an empty string when Wi-Fi is disconnected.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "connected_network_id"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "connected_network_id",
            "response_key": "connected_network_id",
            "preconditions": {}
          },
          "response": {
            "connected_network_id": {
              "type": "string",
              "description": "The connected saved network ID, or an empty string when disconnected."
            }
          }
        },
        "connect": {
          "description": "Connect to a saved network by ID. Wi-Fi must be enabled and network_id must identify an existing record in saved_networks. A successful call replaces any current connection with the selected network. No real network access or internet availability is implied. Invalid input or an unmet precondition leaves state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "network_id": {
                "type": "string",
                "description": "The stable ID of an existing saved network.",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128,
                "examples": [
                  "Home",
                  "Office"
                ]
              }
            },
            "required": [
              "network_id"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "enabled",
            "saved_networks"
          ],
          "writes": [
            "connected_network_id"
          ],
          "semantics": {
            "kind": "update",
            "fields": {
              "connected_network_id": {
                "parameter": "network_id"
              }
            },
            "preconditions": {
              "enabled": true,
              "saved_networks": {
                "contains_key": {
                  "parameter": "network_id"
                }
              }
            }
          },
          "argument_sources": {
            "network_id": {
              "property": "saved_networks",
              "field": "$key"
            }
          },
          "errorcodes": {
            "NOT_FOUND": "The supplied network ID is not present in saved_networks.",
            "PRECONDITION_FAILED": "Wi-Fi is disabled."
          }
        },
        "disconnect": {
          "description": "Disconnect Wi-Fi by setting connected_network_id to an empty string. Saved networks and the enabled setting are preserved. The operation is idempotent when already disconnected.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [],
          "writes": [
            "connected_network_id"
          ],
          "semantics": {
            "kind": "update",
            "fields": {
              "connected_network_id": {
                "value": ""
              }
            },
            "preconditions": {}
          }
        },
        "forget_network": {
          "description": "Forget an existing saved network by ID. Only the selected record is removed and all unrelated records are preserved. If the forgotten network is currently connected, connected_network_id is immediately cleared; otherwise the current connection is preserved. An unknown ID or invalid input leaves all state unchanged.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "network_id": {
                "type": "string",
                "description": "The stable ID of the saved network to forget.",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128,
                "examples": [
                  "Home",
                  "Office"
                ]
              }
            },
            "required": [
              "network_id"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "saved_networks",
            "connected_network_id"
          ],
          "writes": [
            "saved_networks",
            "connected_network_id"
          ],
          "semantics": {
            "kind": "collection_delete",
            "property": "saved_networks",
            "id_parameter": "network_id",
            "preconditions": {
              "saved_networks": {
                "contains_key": {
                  "parameter": "network_id"
                }
              }
            }
          },
          "argument_sources": {
            "network_id": {
              "property": "saved_networks",
              "field": "$key"
            }
          },
          "errorcodes": {
            "NOT_FOUND": "The supplied network ID is not present in saved_networks."
          }
        }
      },
      "disabled": []
    },
    "events": {
      "update": {},
      "disabled": []
    }
  }
}
