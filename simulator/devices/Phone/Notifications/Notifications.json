          }
        },
        "dismiss_notification": {
          "description": "Dismiss an existing synthetic notification by deleting only its record. The notification must have dismissible set to true. A nonexistent ID or a nondismissible notification causes an explicit failure and leaves every notification unchanged.",
          "parameters_schema": {
            "type": "object",
