                "notifications_enabled": true,
                "alert_behavior": "alert",
                "lock_screen_display": "hide_content"
              }
            },
            "schema": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "app_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "maxLength": 128
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "notifications_enabled": {
