          "argument_sources": {
            "channel_id": {
              "property": "channel_settings",
              "field": "$key"
            }
          },
          "errorcodes": {
            "NOT_FOUND": "Channel ID does not exist.",
            "INVALID_ARGUMENT": "No preference field was supplied or a supplied value is unsupported."
          }
        },
        "get_current_notifications": {
          "description": "Return all currently posted synthetic notifications keyed by stable notification ID. The records are local simulation metadata and querying them does not dismiss or otherwise change them.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "current_notifications"
