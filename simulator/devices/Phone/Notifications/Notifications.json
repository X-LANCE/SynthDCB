    "functions": {
      "update": {
        "get_application_setting": {
          "description": "Return the notification presentation preferences for one existing application ID. This reports local notification settings and does not report or modify the separate notification-sending authorization owned by Privacy.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "app_id": {
                "type": "string",
                "description": "An existing stable application ID.",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128,
                "examples": [
                  "Chat",
                  "Calendar"
                ]
              }
            },
            "required": [
              "app_id"
            ],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "application_settings"
          ],
          "writes": [],
          "semantics": {
            "kind": "collection_read",
            "property": "application_settings",
            "id_parameter": "app_id",
            "response_key": "application_setting",
            "preconditions": {
              "application_settings": {
                "contains_key": {
                  "parameter": "app_id"
                }
              }
            }
          },
          "argument_sources": {
            "app_id": {
              "property": "application_settings",
              "field": "$key"
            }
          },
          "response": {
            "application_setting": {
              "type": "object",
              "description": "The selected application's notification presentation preferences."
            }
          },
          "errorcodes": {
            "NOT_FOUND": "Application ID does not exist."
          }
        },
        "update_application_setting": {
          "description": "Partially update an existing application's notification presentation preferences. Omitted fields remain unchanged, the application name remains unchanged, and all other application records are preserved. notifications_enabled controls this module's application-level notification preference but does not grant Privacy authorization or guarantee that a notification will be shown or make a sound.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "app_id": {
                "type": "string",
                "description": "An existing stable application ID.",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128,
                "examples": [
                  "Chat",
                  "Calendar"
                ]
              },
              "notifications_enabled": {
                "type": "boolean",
                "description": "Optional application-level notification enablement preference."
              },
              "alert_behavior": {
                "type": "string",
                "description": "Optional application alert preference.",
                "enum": [
                  "alert",
                  "silent"
                ],
                "examples": [
                  "alert",
                  "silent"
                ]
              },
              "lock_screen_display": {
                "type": "string",
                "description": "Optional application lock-screen content preference.",
                "enum": [
                  "show_content",
                  "hide_content",
                  "do_not_show"
                ],
                "examples": [
                  "show_content",
                  "hide_content",
                  "do_not_show"
                ]
              }
            },
            "required": [
              "app_id"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "application_settings"
          ],
          "writes": [
            "application_settings"
          ],
          "semantics": {
            "kind": "collection_update",
            "property": "application_settings",
            "id_parameter": "app_id",
            "fields": {
              "notifications_enabled": {
                "parameter": "notifications_enabled"
              },
              "alert_behavior": {
                "parameter": "alert_behavior"
              },
              "lock_screen_display": {
                "parameter": "lock_screen_display"
              }
            },
            "preconditions": {
              "application_settings": {
                "contains_key": {
                  "parameter": "app_id"
                }
              }
            }
          },
          "argument_sources": {
            "app_id": {
              "property": "application_settings",
              "field": "$key"
            }
          },
          "errorcodes": {
            "NOT_FOUND": "Application ID does not exist.",
            "INVALID_ARGUMENT": "No preference field was supplied or a supplied value is unsupported."
          }
        },
