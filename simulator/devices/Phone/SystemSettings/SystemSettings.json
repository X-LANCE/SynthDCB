            }
          }
        },
        "set_automatic_time": {
          "description": "Enable or disable automatic date and time synchronization. Enabling uses the local simulated time source and resets wall_clock_offset_minutes to zero. Disabling preserves the current offset. No network access occurs, and the world monotonic clock is never changed.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "examples": [
                  true,
                  false
                ]
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [],
          "writes": [
            "automatic_time",
            "wall_clock_offset_minutes"
          ],
          "semantics": {
            "kind": "set",
            "property": "automatic_time",
            "parameter": "enabled",
            "preconditions": {}
          }
        },
        "get_wall_clock_offset_minutes": {
          "description": "Return the phone wall-clock adjustment in whole minutes relative to the local simulated time source. This value does not affect monotonic Timer or Stopwatch progress.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "wall_clock_offset_minutes"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "wall_clock_offset_minutes",
            "response_key": "wall_clock_offset_minutes",
            "preconditions": {}
          },
          "response": {
            "wall_clock_offset_minutes": {
              "type": "integer",
              "description": "The current phone wall-clock offset in whole minutes."
            }
          }
        },
        "set_manual_datetime": {
          "description": "Set the phone's manual date and time as a whole-minute offset from the local simulated time source. The offset must be between -525600 and 525600 minutes, and automatic_time must be disabled. Invalid input or an enabled automatic-time setting leaves all state unchanged. This operation never modifies the world monotonic clock.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "wall_clock_offset_minutes": {
                "type": "integer",
                "minimum": -525600,
                "maximum": 525600,
                "multipleOf": 1,
                "examples": [
                  -60,
                  0,
                  120,
                  1440
                ]
              }
            },
            "required": [
              "wall_clock_offset_minutes"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "automatic_time"
          ],
          "writes": [
            "wall_clock_offset_minutes"
          ],
          "semantics": {
            "kind": "set",
            "property": "wall_clock_offset_minutes",
            "parameter": "wall_clock_offset_minutes",
            "preconditions": {
              "automatic_time": false
            }
          },
          "errorcodes": {
            "PRECONDITION_FAILED": "Manual date and time cannot be changed while automatic time is enabled."
          }
        },
        "get_automatic_time_zone": {
