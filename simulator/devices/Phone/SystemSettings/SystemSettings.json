        "change_default_application_role": {
          "description": "Resolve a simulated request to change one default application role. The role must exist and application_id must be listed in that role's read-only candidate record. When user_confirmed is true, only that role's application_id is changed and all other role records are preserved. When user_confirmed is false, the request is treated as denied and the original role setting is preserved. Invalid role or candidate input is rejected before any state change.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64,
                "examples": [
                  "browser",
                  "maps"
                ]
              },
              "application_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64,
                "examples": [
                  "browser_beta",
                  "maps_offline"
                ]
              },
              "user_confirmed": {
                "type": "boolean",
                "description": "The deterministic result of simulated user confirmation.",
                "examples": [
                  true,
                  false
                ]
              }
            },
            "required": [
              "role_id",
              "application_id",
              "user_confirmed"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "role_candidates",
            "default_application_roles"
          ],
          "writes": [
            "default_application_roles"
          ],
          "semantics": {
            "kind": "custom",
            "reason": "The operation conditionally updates one collection record only after validating a candidate in a separate nested configuration record and resolving simulated user confirmation; denial must succeed without changing the collection."
          },
          "argument_sources": {
            "role_id": {
              "property": "default_application_roles",
              "field": "$key"
            }
          },
          "response": {
            "changed": {
              "type": "boolean",
              "description": "Whether confirmation was granted and the selected role was changed."
            },
            "application_id": {
              "type": "string",
              "description": "The application ID that remains selected for the role after the request is resolved."
            }
          },
          "errorcodes": {
            "NOT_FOUND": "The default-role ID does not exist.",
            "INELIGIBLE_CANDIDATE": "The requested application is not an eligible candidate for the selected role."
          }
        }
      },
      "disabled": []
    },
    "events": {
      "update": {},
      "disabled": []
    }
  }
}
