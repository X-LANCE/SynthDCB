        "get_default_application_role": {
          "description": "Return the current default application record for a specified role. An unknown role ID is rejected without changing state.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64,
                "examples": [
                  "browser",
                  "maps"
                ]
              }
            },
