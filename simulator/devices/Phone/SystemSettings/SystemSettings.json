                ],
                "examples": [
                  "UTC",
                  "America/New_York",
                  "Europe/Madrid",
                  "Asia/Shanghai"
                ]
              }
            },
            "required": [
              "time_zone"
            ],
            "additionalProperties": false
          },
          "mutation": true,
          "reads": [
            "automatic_time_zone"
          ],
          "writes": [
            "time_zone"
          ],
          "semantics": {
            "kind": "set",
            "property": "time_zone",
            "parameter": "time_zone",
            "preconditions": {
              "automatic_time_zone": false
            }
          },
          "errorcodes": {
            "PRECONDITION_FAILED": "A manual time zone cannot be selected while automatic time zone is enabled."
          }
        },
        "get_role_candidates": {
