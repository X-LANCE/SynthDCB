          "mutation": true,
          "reads": [
            "available_languages"
          ],
          "writes": [
            "system_language"
          ],
          "semantics": {
            "kind": "set",
            "property": "system_language",
            "parameter": "language",
            "preconditions": {
              "available_languages": {
                "contains_key": {
                  "parameter": "language"
                }
              }
            }
          },
          "argument_sources": {
            "language": {
              "property": "available_languages",
              "field": "$key"
            }
          },
          "errorcodes": {
            "NOT_FOUND": "The requested system language is not available."
          }
        },
        "get_application_supported_languages": {
          "description": "Return the read-only supported-language record for a specified application. An unknown application ID is rejected without changing state.",
          "parameters_schema": {
            "type": "object",
            "properties": {
