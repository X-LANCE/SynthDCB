        "set_manual_time_zone": {
          "description": "Set the phone time zone to one of UTC, America/New_York, Europe/Madrid, or Asia/Shanghai. Automatic time-zone selection must be disabled. Invalid identifiers or an enabled automatic-time-zone setting leave all state unchanged. The change affects wall-clock interpretation only and never changes monotonic time.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "time_zone": {
                "type": "string",
                "enum": [
                  "UTC",
                  "America/New_York",
                  "Europe/Madrid",
