        "set_application_language": {
          "description": "Set one existing application's language preference while preserving every other application record. The value system makes the application follow system_language. Any explicit language must appear in that application's application_supported_languages record. Unknown applications or unsupported explicit languages are rejected before any state change.",
          "parameters_schema": {
            "type": "object",
            "properties": {
              "application_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64,
                "examples": [
                  "browser",
                  "maps"
                ]
              },
              "language": {
                "type": "string",
                "enum": [
                  "system",
                  "en-US",
                  "es-ES",
                  "zh-CN"
                ],
                "examples": [
                  "system",
                  "en-US",
                  "es-ES"
                ]
              }
            },
            "required": [
              "application_id",
              "language"
