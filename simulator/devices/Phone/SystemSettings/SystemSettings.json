          "mutation": false,
          "reads": [
            "application_supported_languages"
          ],
          "writes": [],
          "semantics": {
            "kind": "collection_read",
            "property": "application_supported_languages",
            "id_parameter": "application_id",
            "response_key": "supported_languages"
          },
          "argument_sources": {
            "application_id": {
              "property": "application_supported_languages",
