            "preconditions": {
              "application_languages": {
                "contains_key": {
                  "parameter": "application_id"
                }
              }
            }
          },
          "argument_sources": {
            "application_id": {
              "property": "application_languages",
              "field": "$key"
            }
          },
          "errorcodes": {
            "NOT_FOUND": "The application ID has no language preference record.",
            "UNSUPPORTED_LANGUAGE": "The explicit language is not supported by the selected application."
          }
        },
        "get_automatic_time": {
          "description": "Return whether phone date and time are synchronized to the local simulated time source.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "automatic_time"
          ],
          "writes": [],
          "semantics": {
            "kind": "read",
            "property": "automatic_time",
            "response_key": "automatic_time",
            "preconditions": {}
