        },
        "get_time_zone": {
          "description": "Return the phone time-zone identifier without changing its wall clock or monotonic time.",
          "parameters_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "mutation": false,
          "reads": [
            "time_zone"
          ],
