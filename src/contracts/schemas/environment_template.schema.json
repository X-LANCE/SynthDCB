{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dcb:v2:schema:environment-template",
  "title": "DCB environment template",
  "type": "object",
  "required": ["template_id", "domain_type", "domain_metadata", "spaces", "objects", "runtime"],
  "properties": {
    "template_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
    "domain_type": {"$ref": "urn:dcb:v2:schema:common#/$defs/identifier"},
    "domain_metadata": {
      "type": "object",
      "additionalProperties": {"$ref": "urn:dcb:v2:schema:common#/$defs/jsonValue"}
    },
    "spaces": {
      "type": "object",
      "propertyNames": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
      "additionalProperties": {"$ref": "urn:dcb:v2:schema:common#/$defs/spaceInstance"}
    },
    "objects": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
      "additionalProperties": {"$ref": "urn:dcb:v2:schema:common#/$defs/objectInstance"}
    },
    "runtime": {"$ref": "urn:dcb:v2:schema:common#/$defs/runtimeInit"},
    "scene_metadata": {
      "type": "object",
      "additionalProperties": {"$ref": "urn:dcb:v2:schema:common#/$defs/jsonValue"}
    }
  },
  "additionalProperties": false
}
