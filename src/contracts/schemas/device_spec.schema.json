{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dcb:v2:schema:device-spec",
  "title": "Device class specification",
  "$defs": {
    "function": {
      "$ref": "urn:dcb:v2:schema:capability#/$defs/function"
    },
    "process": {
      "$ref": "urn:dcb:v2:schema:capability#/$defs/process"
    }
  },
  "type": "object",
  "patternProperties": {
    "^[A-Z][a-zA-Z0-9]*$": {
      "type": "object",
      "properties": {
        "process": {
          "$ref": "#/$defs/process"
        },
        "meta": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "from": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "description",
            "version"
          ]
        },
        "properties": {
          "type": "object",
          "properties": {
            "update": {
              "type": "object",
              "patternProperties": {
                "^[a-z_][a-z0-9_]*$": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "boolean",
                        "integer",
                        "float",
                        "number",
                        "string",
                        "dict",
                        "object"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "integer",
                      "enum": [
                        0,
                        2,
                        3
                      ]
                    },
                    "auto_reset": {
                      "type": "boolean"
                    },
                    "value": {
                      "type": "object",
                      "properties": {
                        "default": {},
                        "unit": {
                          "type": "string"
                        },
                        "minimum": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "maximum": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "step": {
                          "type": "number"
                        },
                        "step_origin": {
                          "type": "number"
                        },
                        "precision": {
                          "type": "integer"
                        },
                        "choices": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "pattern": {
                          "type": "string"
                        },
                        "max_length": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "required": [
                    "type",
                    "description",
                    "mode",
                    "value"
                  ]
                }
              }
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "functions": {
          "type": "object",
          "properties": {
            "update": {
              "type": "object",
              "patternProperties": {
                "^[a-z_][a-z0-9_]*$": {
                  "type": "object",
                  "allOf": [
                    {
                      "$ref": "#/$defs/function"
                    }
                  ],
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "response": {
                      "type": "object",
                      "patternProperties": {
                        "^[a-z_][a-z0-9_]*$": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "type",
                            "description"
                          ]
                        }
                      }
                    },
                    "errorcodes": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "description"
                  ]
                }
              }
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "events": {
          "type": "object",
          "properties": {
            "update": {
              "type": "object",
              "patternProperties": {
                "^[a-z_][a-z0-9_]*$": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "effect_properties": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "description"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "description",
                    "effect_properties"
                  ]
                }
              }
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "meta",
        "properties",
        "functions",
        "events"
      ]
    }
  },
  "minProperties": 1,
  "maxProperties": 1
}
