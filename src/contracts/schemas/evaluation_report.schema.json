{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dcb:v2:schema:evaluation-report",
  "title": "DCB v2 per-scenario evaluation report",
  "type": "object",
  "required": [
    "world_id",
    "task_id",
    "task_success",
    "state_success",
    "answer_success",
    "answer_alignment",
    "report_success",
    "report_semantic_success",
    "report_judge",
    "memory_success",
    "memory_judge",
    "time_constraint_success",
    "termination",
    "assertions",
    "metrics",
    "trajectory_summary",
    "errors"
  ],
  "properties": {
    "world_id": {
      "$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"
    },
    "task_id": {
      "$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"
    },
    "task_success": {
      "type": "boolean"
    },
    "state_success": {
      "type": "boolean"
    },
    "answer_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "answer_alignment": {
      "type": "object",
      "required": ["matches", "missing_expected_indices", "extra_submitted_indices"],
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["expected_index", "submitted_index", "score", "exact"],
            "properties": {
              "expected_index": {"type": "integer", "minimum": 0},
              "submitted_index": {"type": "integer", "minimum": 0},
              "score": {"type": "number", "minimum": 0, "maximum": 1},
              "exact": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "missing_expected_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "extra_submitted_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "report_semantic_success": {"type": ["boolean", "null"]},
    "report_judge": {"type": ["object", "null"]},
    "report_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "memory_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "memory_judge": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/memoryJudge"
        }
      ]
    },
    "time_constraint_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "termination": {
      "$ref": "urn:dcb:v2:schema:termination"
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertionResult"
      }
    },
    "metrics": {
      "$ref": "#/$defs/runMetrics"
    },
    "trajectory_summary": {
      "$ref": "#/$defs/trajectorySummary"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "urn:dcb:v2:schema:common#/$defs/error"
      }
    },
    "workflow_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "workflow": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "$defs": {
    "assertionResult": {
      "type": "object",
      "required": [
        "assertion_id",
        "scope",
        "target_id",
        "property",
        "assertion",
        "initial_value",
        "final_value",
        "passed"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"
        },
        "scope": {
          "type": "string",
          "enum": [
            "object",
            "space",
            "runtime"
          ]
        },
        "target_id": {
          "$ref": "urn:dcb:v2:schema:common#/$defs/identifier"
        },
        "property": {
          "$ref": "urn:dcb:v2:schema:common#/$defs/identifier"
        },
        "assertion": {
          "$ref": "urn:dcb:v2:schema:target#/$defs/assertion"
        },
        "initial_value": {
          "$ref": "urn:dcb:v2:schema:common#/$defs/jsonValue"
        },
        "final_value": {
          "$ref": "urn:dcb:v2:schema:common#/$defs/jsonValue"
        },
        "passed": {
          "type": "boolean"
        },
        "failure_reason": {
          "type": "string",
          "enum": [
            "missing_target",
            "missing_property",
            "operator_failed",
            "invalid_numeric_value"
          ]
        }
      },
      "additionalProperties": false
    },
    "runMetrics": {
      "type": "object",
      "required": [
        "object_property_accuracy",
        "space_state_pass",
        "space_property_accuracy",
        "action_success_rate",
        "answer_accuracy",
        "report_accuracy",
        "report_count_accuracy",
        "report_semantic_accuracy",
        "memory_rouge_l_f1",
        "effect_replay_pass",
        "unexpected_side_effect_count",
        "false_complete",
        "time_plan_valid"
      ],
      "properties": {
        "object_property_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "space_state_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "space_property_accuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "action_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "answer_accuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "report_count_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "report_semantic_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "report_accuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "memory_rouge_l_f1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "effect_replay_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unexpected_side_effect_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "false_complete": {
          "type": "boolean"
        },
        "time_plan_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "background_change_count": {
          "type": "integer",
          "minimum": 0
        },
        "list_answer_recall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "memoryJudge": {
      "type": "object",
      "required": [
        "status",
        "requested_model",
        "response_model",
        "endpoint",
        "latency_seconds",
        "usage",
        "request",
        "raw_response",
        "items",
        "error"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "ERROR"
          ]
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "response_model": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "latency_seconds": {
          "type": "number",
          "minimum": 0
        },
        "usage": {
          "$ref": "urn:dcb:v2:schema:common#/$defs/jsonValue"
        },
        "request": {
          "type": "object"
        },
        "raw_response": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "mutation_id",
              "pass",
              "reason"
            ],
            "properties": {
              "mutation_id": {
                "$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"
              },
              "pass": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "trajectorySummary": {
      "type": "object",
      "required": [
        "turns",
        "total_tool_calls",
        "mutation_attempts",
        "successful_mutations",
        "failed_calls",
        "finish_observed",
        "termination_reason"
      ],
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "total_tool_calls": {
          "description": "Number of command attempts excluding session_finish, whether automatic or explicit.",
          "type": "integer",
          "minimum": 0
        },
        "mutation_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "successful_mutations": {
          "type": "integer",
          "minimum": 0
        },
        "failed_calls": {
          "type": "integer",
          "minimum": 0
        },
        "finish_observed": {
          "type": "boolean"
        },
        "termination_reason": {
          "type": "string",
          "enum": [
            "session_finish",
            "max_turns",
            "elapsed_time_limit",
            "agent_stopped"
          ]
        },
        "token_usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
