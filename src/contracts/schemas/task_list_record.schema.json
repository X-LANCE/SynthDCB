{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dcb:v2:schema:task-list-record",
  "title": "DCB v2 validated task success record",
  "type": "object",
  "required": [
    "generation_run_id",
    "authoring_run_id",
    "task_id",
    "domain",
    "task_family",
    "task_subtype",
    "sampling_profile_id",
    "sampling",
    "source_world_id",
    "source_world_root",
    "effective_world_root",
    "effective_world_batch_id",
    "task_root",
    "validation_metadata_path",
    "instruction_style",
    "random_seed",
    "initial_tweaks",
    "model_calls",
    "usage",
    "response_models",
    "audit_record_path"
  ],
  "properties": {
    "generation_run_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
    "authoring_run_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
    "task_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
    "domain": {"$ref": "urn:dcb:v2:schema:common#/$defs/identifier"},
    "task_family": {"$ref": "urn:dcb:v2:schema:task#/$defs/taskFamily"},
    "task_subtype": {"$ref": "urn:dcb:v2:schema:task#/$defs/taskSubtype"},
    "sampling_profile_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
    "sampling": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "urn:dcb:v2:schema:common#/$defs/jsonValue"}
    },
    "source_world_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
    "source_world_root": {"type": "string", "minLength": 1},
    "effective_world_root": {"type": "string", "minLength": 1},
    "effective_world_batch_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
    "task_root": {"type": "string", "minLength": 1},
    "validation_metadata_path": {"type": "string", "minLength": 1},
    "instruction_style": {"type": "string", "enum": ["direct", "polite", "conversational", "distracting", "folk", "concise", "implicit", "contextual"]},
    "random_seed": {"type": "integer"},
    "initial_tweaks": {"type": "array", "items": {"type": "object"}},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "model_calls": {"type": "integer", "minimum": 0},
    "usage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "response_models": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "audit_record_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
