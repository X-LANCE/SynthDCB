{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dcb:v2:schema:benchmark-report",
  "title": "DCB v2 aggregate benchmark report",
  "type": "object",
  "required": ["run_id", "sample_count", "metrics", "breakdowns"],
  "properties": {
    "run_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
    "sample_count": {"type": "integer", "minimum": 1},
    "metrics": {
      "type": "object",
      "required": [
        "scenario_pass_rate",
        "pass_at_n",
        "avg_property_accuracy",
        "avg_action_success_rate",
        "avg_turns",
        "avg_total_actions",
        "avg_answer_accuracy",
        "avg_report_accuracy"
      ],
      "properties": {
        "scenario_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "pass_at_n": {
          "type": "object",
          "patternProperties": {
            "^[1-9][0-9]*$": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "avg_property_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "avg_action_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "avg_turns": {"type": "number", "minimum": 0},
        "avg_total_actions": {"type": "number", "minimum": 0},
        "avg_list_answer_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "avg_answer_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "avg_report_count_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "avg_report_semantic_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "semantic_scenario_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "avg_report_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "token_usage": {
          "type": "object",
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0}
          },
          "required": ["input_tokens", "output_tokens"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "breakdowns": {
      "type": "object",
      "required": [
        "task_family",
        "task_subtype",
        "task_category",
        "termination_reason"
      ],
      "properties": {
        "task_family": {"$ref": "#/$defs/breakdown"},
        "task_subtype": {"$ref": "#/$defs/breakdown"},
        "task_category": {"$ref": "#/$defs/breakdown"},
        "termination_reason": {"$ref": "#/$defs/breakdown"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "breakdown": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["attempt_count", "pass_rate"],
        "properties": {
          "attempt_count": {"type": "integer", "minimum": 1},
          "pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
