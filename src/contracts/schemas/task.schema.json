{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dcb:v2:schema:task",
  "title": "DCB agent-facing task.json",
  "type": "object",
  "required": [
    "task_id",
    "instruction",
    "meta"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "current_user": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["user_id", "name"],
          "properties": {
            "user_id": {"$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"},
            "name": {"type": "string", "minLength": 1},
            "space_id": {"type": ["string", "null"]},
            "space_name": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "instruction_variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/instructionVariant"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "task_family",
        "task_subtype"
      ],
      "properties": {
        "task_family": {
          "$ref": "#/$defs/taskFamily"
        },
        "task_subtype": {
          "$ref": "#/$defs/taskSubtype"
        },
        "source_task_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:dcb:v2:schema:common#/$defs/nonSessionIdentifier"
          },
          "minItems": 2,
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "task_family": {
                "const": "query"
              }
            }
          },
          "then": {
            "properties": {
              "task_subtype": {
                "enum": [
                  "property.device",
                  "property.space",
                  "space.person_location",
                  "space.occupants",
                  "target.quantity",
                  "target.enum",
                  "target.comparison.top1",
                  "target.comparison.topk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_family": {
                "const": "control"
              }
            }
          },
          "then": {
            "properties": {
              "task_subtype": {
                "enum": [
                  "single",
                  "multi_property",
                  "multi_target",
                  "complex"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_family": {
                "const": "goal"
              }
            }
          },
          "then": {
            "properties": {
              "task_subtype": {
                "enum": [
                  "single",
                  "multi_property",
                  "multi_target",
                  "complex"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_family": {
                "const": "aggregate"
              }
            }
          },
          "then": {
            "required": [
              "source_task_ids"
            ],
            "properties": {
              "task_subtype": {
                "enum": [
                  "control_query",
                  "control_goal",
                  "query_goal",
                  "control_query_goal",
                  "query",
                  "control",
                  "goal"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_family": {
                "const": "workflow"
              }
            }
          },
          "then": {
            "properties": {
              "task_subtype": {
                "enum": [
                  "single",
                  "condition_follow",
                  "condition_delay",
                  "condition_window",
                  "synchronize",
                  "at",
                  "before",
                  "environment_deadline",
                  "environment_before_process"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "taskFamily": {
      "type": "string",
      "enum": [
        "query",
        "control",
        "goal",
        "aggregate",
        "workflow"
      ]
    },
    "taskSubtype": {
      "type": "string",
      "enum": [
        "property.device",
        "property.space",
        "space.person_location",
        "space.occupants",
        "target.quantity",
        "target.enum",
        "target.comparison.top1",
        "target.comparison.topk",
        "single",
        "multi_property",
        "multi_target",
        "complex",
        "control_query",
        "control_goal",
        "query_goal",
        "control_query_goal",
        "condition_follow",
        "condition_delay",
        "condition_window",
        "synchronize",
        "at",
        "before",
        "environment_deadline",
        "environment_before_process",
        "query",
        "control",
        "goal"
      ]
    },
    "instructionVariant": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "enum": [
            "template",
            "llm"
          ]
        },
        {
          "type": "string",
          "enum": [
            "direct",
            "polite",
            "conversational",
            "distracting",
            "folk",
            "implicit",
            "concise",
            "contextual"
          ]
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  },
  "additionalProperties": false
}
