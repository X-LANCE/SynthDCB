{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dcb:v2:schema:contract-manifest",
  "title": "DCB v2 contract package manifest",
  "type": "object",
  "required": [
    "contract_version",
    "package_type",
    "status",
    "json_schema_draft",
    "schemas"
  ],
  "properties": {
    "contract_version": {"const": "2.8.0"},
    "package_type": {"const": "contracts"},
    "status": {"const": "frozen"},
    "json_schema_draft": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/schemaEntry"}
    }
  },
  "$defs": {
    "schemaEntry": {
      "type": "object",
      "required": ["path", "id", "role"],
      "properties": {
        "path": {"type": "string"},
        "id": {"type": "string", "pattern": "^urn:dcb:v2:schema:"},
        "role": {
          "type": "string",
          "enum": ["common", "data", "protocol", "evaluator", "domain", "manifest"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
